# Copy this file to `.env` and fill in a real key. `.env` is git-ignored.
#
# Get a free Google AI Studio key at: https://aistudio.google.com/apikey
# The free tier is rate-limited (requests per minute / per day) but costs nothing.
GEMINI_API_KEY=your-google-ai-studio-key-here

# --- Optional overrides (defaults shown) ---

# Any model your key can reach. `gemini-3.6-flash` is the free-tier workhorse;
# `gemini-2.5-pro` gives better analysis but has a much lower free quota.
# GEMINI_MODEL=gemini-3.6-flash

# Seconds to wait on a single API call before giving up.
# REQUEST_TIMEOUT=60.0

# How many times to retry a rate-limited or server-side failure.
# MAX_RETRIES=3

# Reject snippets larger than this, before spending a request on them.
# MAX_SNIPPET_CHARS=100000
